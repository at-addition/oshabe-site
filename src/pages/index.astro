---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { THEMES } from '../lib/themes';
import { FIRST } from '../lib/themes';
// 当時のマスコットの鳥（design/original/beyan_177x156.png をなぞった SVG）
import bird from '../assets/beyan.svg?raw';

const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [latest, ...rest] = posts;
// カテゴリは記事の多い順。テーマの色があるものは色付きで出す
const counts = new Map<string, number>();
posts.forEach((p) => p.data.categories.forEach((c) => counts.set(c, (counts.get(c) ?? 0) + 1)));
const cats = [...counts].sort((a, b) => b[1] - a[1]).map(([cat, count]) => ({ cat, count, hue: THEMES.find((t) => t.cat === cat)?.hue }));
const first = posts[posts.length - 1]?.data.pubDate.getFullYear();
const last = latest?.data.pubDate.getFullYear();
---

<Base>

  {latest && (
    <section class="latest" aria-label="いちばん新しい記事">
      <PostCard post={latest} featured />
    </section>
  )}

  <section class="filters" aria-label="カテゴリで絞り込む">
    <button type="button" class="f-cat" data-cat="" aria-pressed="true">すべて <small>{posts.length}</small></button>
    {cats.map((c) => (
      <button type="button" class="f-cat" data-cat={c.cat} aria-pressed="false" style={c.hue !== undefined ? `--hue:${c.hue}` : undefined}>
        {c.cat} <small>{c.count}</small>
      </button>
    ))}
  </section>

  <section class="grid" aria-label="記事の一覧" data-total={rest.length} data-src={`${import.meta.env.BASE_URL}cards.json`}>
    {rest.slice(0, FIRST).map((p) => <PostCard post={p} />)}
  </section>
  <p class="more-wrap"><button type="button" class="more" hidden>もっと見る</button></p>
  <p class="empty" hidden>この条件の記事はありません。</p>

  <!-- サイトの紹介は一覧のあと、フッターの直前に置く（開いたらすぐ記事が見えるように） -->
  <section class="hero">
    <div class="hero-text">
      <p class="hero-kicker">OSHABE.com</p>
      <h1>あなたを<br />おしゃべりにする<br />ひとネタ</h1>
      <p class="hero-lead">100均の新商品、USJ やディズニーのグッズ、ハロウィンやクリスマスの小物。写真たっぷりで紹介します。</p>
      <p class="hero-stats">
        <span><b>{posts.length}</b> 記事</span>
        <span><b>{first === last ? first : `${first}–${last}`}</b></span>
      </p>
    </div>
    <div class="hero-bird" aria-hidden="true" set:html={bird} />
  </section>
</Base>

<script>
  // カテゴリ（?cat=）で一覧を絞る。いちばん新しい記事のカードも同じ条件で隠す
  let cat = new URLSearchParams(location.search).get('cat') ?? '';
  const buttons = document.querySelectorAll<HTMLButtonElement>('.f-cat');
  const grid = document.querySelector<HTMLElement>('.grid')!;
  const empty = document.querySelector<HTMLElement>('.empty')!;
  // 一覧は最初に24本だけ見せ、「もっと見る」で24本ずつ足す（絞り込みを変えたら24本に戻す）。
  // HTML に入っているのは最初の24本だけで、残りは「もっと見る」か絞り込みのときに cards.json から足す
  const STEP = 24;
  let limit = STEP;
  const more = document.querySelector<HTMLButtonElement>('.more')!;
  const total = Number(grid.dataset.total);
  let loaded: Promise<void> | undefined;

  type Row = { u: string; t: string; c: string; h: number; l: string; d: string; e: string; i?: string; w?: number; ht?: number };
  const fmt = (iso: string) => new Date(iso).toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: 'long', day: 'numeric' });
  function loadRest() {
    loaded ??= fetch(grid.dataset.src!).then((r) => r.json()).then((rows: Row[]) => {
      const tpl = grid.querySelector<HTMLElement>('.card');
      if (!tpl) return;
      for (const r of rows) {
        // 最初のカードを写して中身を入れ替える（見た目のクラスをそのまま使うため）
        const c = tpl.cloneNode(true) as HTMLElement;
        c.style.setProperty('--hue', String(r.h));
        c.dataset.cats = r.c;
        c.querySelector('a')!.href = r.u;
        const thumb = c.querySelector<HTMLElement>('.thumb')!;
        const img = thumb.querySelector('img');
        if (r.i && img) {
          img.removeAttribute('srcset');
          img.src = r.i; img.width = r.w ?? 480; img.height = r.ht ?? 360; img.alt = '';
        } else if (img) {
          const s = document.createElement('span');
          for (const a of img.getAttributeNames()) if (a.startsWith('data-astro')) s.setAttribute(a, '');
          s.className = 'thumb-fallback'; s.textContent = r.l;
          img.replaceWith(s);
        }
        c.querySelector('.theme-badge')!.textContent = r.l;
        const time = c.querySelector('time')!;
        time.dateTime = r.d; time.textContent = fmt(r.d);
        c.querySelector('h3')!.textContent = r.t;
        c.querySelector('.excerpt')!.textContent = r.e;
        c.hidden = true;
        grid.append(c);
      }
    });
    return loaded;
  }

  function apply() {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.cat ?? '') === cat)));
    let shown = 0, inGrid = 0;
    document.querySelectorAll<HTMLElement>('.card').forEach((c) => {
      const ok = !cat || (c.dataset.cats ?? '').split('|').includes(cat);
      const latest = c.parentElement?.classList.contains('latest');
      if (ok) shown++;
      if (latest) { c.parentElement!.hidden = !ok; return; }
      if (ok) inGrid++;
      c.hidden = !ok || inGrid > limit;
    });
    empty.hidden = shown > 0;
    more.hidden = (loaded || cat ? inGrid : total) <= limit;
    const url = new URL(location.href);
    cat ? url.searchParams.set('cat', cat) : url.searchParams.delete('cat');
    history.replaceState(null, '', url);
  }
  // 絞り込むときと、最初の24本より先を見るときは、残りを読み込んでから並べ直す
  const update = () => (cat || limit > STEP ? loadRest().then(apply) : apply());
  buttons.forEach((b) => b.addEventListener('click', () => { cat = b.dataset.cat ?? ''; limit = STEP; update(); }));
  more.addEventListener('click', () => { limit += STEP; update(); });
  update();
</script>

<style>
  .hero {
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 24px;
    margin-top: 64px; padding: 40px 0 8px; border-top: 1px solid var(--line);
  }
  .hero-kicker { margin: 0; font-size: 0.78rem; letter-spacing: 0.28em; color: var(--accent); font-weight: 700; }
  .hero h1 {
    margin: 8px 0 14px; font-family: 'Zen Maru Gothic', sans-serif; font-weight: 900;
    font-size: clamp(1.9rem, 5.6vw, 3.1rem); line-height: 1.3; letter-spacing: 0.03em;
  }
  .hero-lead { margin: 0; color: var(--muted); max-width: 34em; }
  .hero-stats { display: flex; gap: 20px; margin: 16px 0 0; color: var(--muted); font-size: 0.9rem; }
  .hero-stats b { color: var(--fg); font-size: 1.2rem; margin-right: 4px; font-variant-numeric: tabular-nums; }
  /* 鳥は黒いので、暗い画面でも見えるよう白い丸に乗せる */
  .hero-bird {
    width: clamp(140px, 24vw, 230px); aspect-ratio: 1; border-radius: 50%; background: #fff;
    box-shadow: var(--shadow); display: grid; place-items: center; padding: 8%;
    border: 6px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .hero-bird :global(svg) { width: 100%; height: auto; display: block; }
  @media (max-width: 600px) {
    .hero { grid-template-columns: 1fr; }
    .hero-bird { order: -1; width: 120px; }
  }

  .latest { margin: 32px 0 36px; }

  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .filters button {
    font: inherit; font-size: 0.82rem; cursor: pointer; padding: 4px 13px; border-radius: 999px;
    border: 1px solid var(--line); background: var(--surface); color: var(--fg);
  }
  .filters button small { color: var(--muted); margin-left: 2px; }
  .filters button[style] { color: hsl(var(--hue) var(--sat) var(--light)); border-color: transparent; background: hsl(var(--hue) 70% var(--tint)); }
  .filters button[aria-pressed='true'] { background: var(--fg); color: var(--bg); border-color: transparent; }
  .filters button[style][aria-pressed='true'] { background: hsl(var(--hue) 70% var(--light)); color: #fff; }
  .filters button[aria-pressed='true'] small { color: inherit; opacity: 0.8; }

  .more-wrap { text-align: center; margin: 28px 0 0; }
  .more {
    font-family: inherit; font-size: 1rem; font-weight: 700; padding: 12px 40px; border-radius: 999px; cursor: pointer;
    background: var(--surface); color: var(--fg); border: 1px solid var(--line); box-shadow: var(--shadow);
  }
  .more:hover { border-color: var(--fg); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 22px; }
  .empty { color: var(--muted); text-align: center; padding: 40px 0; }
</style>
