---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Crumbs from '../components/Crumbs.astro';
import { breadcrumbLd } from '../lib/crumbs';
import { themeOf, excerpt, catUrl, mainCat } from '../lib/themes';

export async function getStaticPaths() {
  // getStaticPaths はこの中だけで動くので、関連記事を選ぶ関数もここに置く。
  // 関連記事: カテゴリが多く重なる順、同じなら公開日が近い順に4本（前後の記事は除く）。新しい記事にも自動で付く
  const relatedOf = (post: CollectionEntry<'posts'>, pool: CollectionEntry<'posts'>[]) => {
    const mine = new Set(post.data.categories);
    const i = pool.indexOf(post);
    const skip = new Set([post, pool[i - 1], pool[i + 1]]);
    return pool
      .filter((p) => !skip.has(p))
      .map((p) => ({ p, score: p.data.categories.filter((c) => mine.has(c)).length, gap: Math.abs(p.data.pubDate.valueOf() - post.data.pubDate.valueOf()) }))
      .sort((a, b) => b.score - a.score || a.gap - b.gap)
      .slice(0, 4)
      .map((x) => x.p);
  }
  const posts = (await getCollection('posts')).sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
  // 前後の記事は公開日の順でたどる
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, prev: posts[i - 1], next: posts[i + 1], related: relatedOf(post, posts) } }));
}

const { post, prev, next, related } = Astro.props;
const { Content } = await render(post);
const theme = themeOf(post.data.categories);
// SNS で共有したときの画像（記事の最初の画像を JPEG で幅 1200 まで）
const ogImage = post.data.cover ? (await getImage({ src: post.data.cover, width: 1200, format: 'jpeg' })).src : undefined;
const base = import.meta.env.BASE_URL;
const fmt = (d: Date) => d.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: 'long', day: 'numeric' });
// 検索エンジン向けの構造化データ（記事）。新しい記事も同じ形で付く
const ldUrl = new URL(`${base}${post.id}/`, Astro.site).href;
// パンくず: トップ › カテゴリ › 記事
const cat = mainCat(post.data.categories);
const crumbs = [{ name: 'トップ', href: base }, ...(cat ? [{ name: cat, href: catUrl(base, cat) }] : []), { name: post.data.title }];
const posting = {
  '@type': 'BlogPosting',
  headline: post.data.title,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  ...(ogImage ? { image: new URL(ogImage, Astro.site).href } : {}),
  author: { '@type': 'Person', name: 'オシャベ' },
  publisher: { '@type': 'Organization', name: 'オシャベ', logo: { '@type': 'ImageObject', url: new URL(`${base}icon-512.png`, Astro.site).href } },
  mainEntityOfPage: ldUrl,
  inLanguage: 'ja',
};
const jsonld = { '@context': 'https://schema.org', '@graph': [posting, breadcrumbLd(crumbs, `${base}${post.id}/`, Astro.site)] };
---

<Base title={post.data.title} description={excerpt(post.body, 110)} image={ogImage} type="article" jsonld={jsonld}>
  <Crumbs items={crumbs} />
  <article class="post" style={`--hue:${theme.hue}`}>
    <header class="post-head">
      <div class="meta">
        {post.data.categories.map((c) => <a class="chip" href={catUrl(base, c)}>#{c}</a>)}
      </div>
      <h1>{post.data.title}</h1>
      <p class="date">
        <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
        {post.data.updatedDate && <span>（{fmt(post.data.updatedDate)} 更新）</span>}
      </p>
    </header>
    <div class="body">
      <Content />
    </div>
  </article>

  {related.length > 0 && (
    <section class="related" aria-labelledby="h-related">
      <h2 id="h-related">あわせて読みたい</h2>
      <div class="related-grid">{related.map((p) => <PostCard post={p} />)}</div>
    </section>
  )}

  <nav class="pager" aria-label="前後の記事">
    {prev ? (
      <a class="prev" href={`${base}${prev.id}/`}><small>← 前の記事</small><span>{prev.data.title}</span></a>
    ) : <span />}
    {next ? (
      <a class="next" href={`${base}${next.id}/`}><small>次の記事 →</small><span>{next.data.title}</span></a>
    ) : <span />}
  </nav>
  <p class="back"><a href={base}>← 記事の一覧へ</a></p>
</Base>

<style>
  .post { max-width: 760px; margin: 16px auto 0; }
  .post-head { padding: 0 4px 24px; border-bottom: 3px solid hsl(var(--hue) 70% var(--light)); margin-bottom: 28px; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .meta .chip { text-decoration: none; }
  h1 { font-family: 'Zen Maru Gothic', sans-serif; font-size: clamp(1.4rem, 4vw, 2rem); line-height: 1.45; margin: 14px 0 8px; font-weight: 900; }
  .date { margin: 0; color: var(--muted); font-size: 0.88rem; }

  .body { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); padding: 32px clamp(18px, 5vw, 48px); }
  /* 元の記事は1行ずつ段落になっているので、段落の間を詰めて当時の見え方に寄せる */
  .body :global(p) { margin: 0.15em 0; }
  .body :global(h2) {
    margin: 2.2em 0 0.8em; padding: 10px 14px; font-size: 1.2rem; line-height: 1.5; border-radius: 10px;
    background: hsl(var(--hue) 70% var(--tint)); border-left: 5px solid hsl(var(--hue) 70% var(--light));
  }
  .body :global(h3) { margin: 1.8em 0 0.6em; font-size: 1.08rem; padding-bottom: 4px; border-bottom: 2px dotted var(--line); }
  .body :global(h4) { margin: 1.4em 0 0.4em; font-size: 1rem; }
  .body :global(img) {
    display: block; margin: 14px auto; border-radius: 10px; width: auto; max-height: 560px;
    box-shadow: 0 2px 10px rgb(0 0 0 / 12%);
  }
  /* 関連記事のカードの画像は小さく */
  .body :global(a img) { display: inline-block; vertical-align: middle; max-height: 96px; margin: 4px 8px 4px 0; box-shadow: none; }
  .body :global(ul) { padding-left: 1.4em; }
  .body :global(blockquote) { margin: 1em 0; padding: 8px 16px; border-left: 4px solid var(--line); color: var(--muted); }
  .body :global(table) { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
  .body :global(td), .body :global(th) { border: 1px solid var(--line); padding: 6px 8px; }

  .related { max-width: 760px; margin: 36px auto 0; }
  .related h2 { font-size: 1.1rem; margin: 0 0 14px; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 16px; }
  .pager { max-width: 760px; margin: 28px auto 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .pager a {
    display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; border-radius: var(--radius);
    background: var(--surface); box-shadow: var(--shadow); color: var(--fg); text-decoration: none; font-size: 0.88rem; line-height: 1.5;
  }
  .pager small { color: var(--muted); }
  .pager .next { text-align: right; }
  .back { max-width: 760px; margin: 24px auto 0; }
  @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } }
</style>
