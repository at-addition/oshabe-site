---
interface Props {
  title?: string;
  description?: string;
}
const SITE_NAME = 'オシャベ';
// 当時のロゴ（OSHABE.com）。元の PNG を色ごとになぞって SVG にしたもの（design/original/logo_338x109.png）
import logo from '../assets/oshabe-logo.svg?raw';
// Google アドセンスのパブリッシャー ID（hqzietq のアカウント。public/ads.txt と揃える）
const ADSENSE_CLIENT = 'ca-pub-5250963766765858';
const { title, description = '100均・USJ・季節のイベントの話題' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- 当時のマスコット（鳥）。タブは SVG、スマホのホーム画面とブックマークは白地の正方形の PNG -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <title>{title ? `${title} | ${SITE_NAME}` : SITE_NAME}</title>
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href={base} aria-label={SITE_NAME}>
        <span class="site-logo" set:html={logo} />
      </a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        <a href={`${base}privacy/`}>プライバシーポリシー</a> ・ <a href={`${base}contact/`}>お問い合わせ</a>
      </p>
      <p>© {SITE_NAME}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7;
    --fg: #222;
    --muted: #666;
    --line: #e4e0d8;
    --accent: #a0522d;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1b1a18;
      --fg: #e8e6e1;
      --muted: #a39e94;
      --line: #36332e;
      --accent: #e0a070;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, -apple-system, 'Hiragino Sans', 'Yu Gothic UI', sans-serif;
    line-height: 1.8;
  }
  main, .site-header, .site-footer {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .site-header { padding-top: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .site-name { color: var(--fg); font-weight: 700; font-size: 1.25rem; text-decoration: none; display: inline-block; }
  /* 当時のロゴ。黒は文字色、目などの白は背景の色に合わせる（暗い画面でも読める） */
  .site-logo { display: block; width: min(260px, 70vw); }
  .site-logo :global(svg) { display: block; width: 100%; height: auto; --logo-hole: var(--bg); }
  .site-footer { margin-top: 48px; padding-top: 16px; padding-bottom: 32px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; }
  a { color: var(--accent); }
  img { max-width: 100%; height: auto; }
</style>
