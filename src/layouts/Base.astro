---
interface Props {
  title?: string;
  description?: string;
}
const SITE_NAME = 'オシャベ';
const { title, description = '2016〜2019年に書いていた、芸能・ドラマ・100均の話題のブログ' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <title>{title ? `${title} | ${SITE_NAME}` : SITE_NAME}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href={base}>{SITE_NAME}</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>2016〜2019年に oshabe.com で公開していた記事を、Wayback Machine に残っていた記録から復元したものです。
        商品や番組の情報は当時のもので、今とは違います。</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7;
    --fg: #222;
    --muted: #666;
    --line: #e4e0d8;
    --accent: #a0522d;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1b1a18;
      --fg: #e8e6e1;
      --muted: #a39e94;
      --line: #36332e;
      --accent: #e0a070;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, -apple-system, 'Hiragino Sans', 'Yu Gothic UI', sans-serif;
    line-height: 1.8;
  }
  main, .site-header, .site-footer {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .site-header { padding-top: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .site-name { color: var(--fg); font-weight: 700; font-size: 1.25rem; text-decoration: none; }
  .site-footer { margin-top: 48px; padding-top: 16px; padding-bottom: 32px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; }
  a { color: var(--accent); }
  img { max-width: 100%; height: auto; }
</style>
