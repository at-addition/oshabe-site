---
// パンくず（トップ › カテゴリ › 記事）。検索エンジン向けの BreadcrumbList は lib/crumbs.ts で作る
interface Props {
  items: { name: string; href?: string }[];
  /** 一覧のページなど、本文の幅に揃えないとき */
  wide?: boolean;
}
const { items, wide = false } = Astro.props;
---

<nav class:list={['crumbs', { wide }]} aria-label="現在地">
  <ol>
    {items.map((it) => <li>{it.href ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>)}
  </ol>
</nav>

<style>
  .crumbs { max-width: 760px; margin: 20px auto 0; font-size: 0.8rem; color: var(--muted); }
  .wide { max-width: none; }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px; }
  li:not(:last-child)::after { content: '›'; margin-left: 6px; }
  a { color: inherit; }
  span { display: inline-block; max-width: 22em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: bottom; }
</style>
