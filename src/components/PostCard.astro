---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { themeOf, excerpt } from '../lib/themes';

interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const theme = themeOf(post.data.categories);
const base = import.meta.env.BASE_URL;
const date = post.data.pubDate.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: 'long', day: 'numeric' });
---

<article class:list={['card', { featured }]} style={`--hue:${theme.hue}`} data-cats={post.data.categories.join('|')}>
  <a href={`${base}${post.id}/`} class="card-link">
    <div class="thumb">
      {post.data.cover ? (
        <Image src={post.data.cover} alt="" width={featured ? 720 : 480} loading={featured ? 'eager' : 'lazy'} />
      ) : (
        <span class="thumb-fallback">{theme.label}</span>
      )}
    </div>
    <div class="body">
      <div class="meta">
        <span class="theme-badge">{theme.label}</span>
        <time datetime={post.data.pubDate.toISOString()}>{date}</time>
      </div>
      <h3>{post.data.title}</h3>
      <p class="excerpt">{excerpt(post.body, featured ? 120 : 60)}</p>
    </div>
  </a>
</article>

<style>
  .card {
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: transform 0.18s ease;
  }
  .card:hover { transform: translateY(-3px); }
  .card-link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
  .thumb {
    aspect-ratio: 4 / 3; overflow: hidden;
    background: linear-gradient(135deg, hsl(var(--hue) 70% 62%), hsl(calc(var(--hue) - 12) 60% 42%));
    display: grid; place-items: center;
  }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .thumb-fallback { font-family: 'Zen Maru Gothic', sans-serif; font-weight: 900; color: rgb(255 255 255 / 90%); font-size: 1.3rem; letter-spacing: 0.08em; }
  .body { padding: 14px 16px 18px; display: flex; flex-direction: column; gap: 6px; }
  .meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 0.78rem; color: var(--muted); }
  h3 { margin: 0; font-size: 1rem; line-height: 1.55; font-weight: 700; }
  .excerpt {
    margin: 0; font-size: 0.82rem; color: var(--muted); line-height: 1.7;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden;
  }

  /* いちばん新しい記事は横長の大きいカード */
  .featured .card-link { flex-direction: row; }
  .featured .thumb { flex: 0 0 52%; aspect-ratio: 16 / 10; }
  .featured .body { padding: 24px 28px; justify-content: center; }
  .featured h3 { font-size: 1.45rem; line-height: 1.45; }
  .featured .excerpt { font-size: 0.92rem; -webkit-line-clamp: 4; line-clamp: 4; }
  @media (max-width: 720px) {
    .featured .card-link { flex-direction: column; }
    .featured .thumb { flex: none; aspect-ratio: 4 / 3; }
    .featured .body { padding: 16px 18px 20px; }
    .featured h3 { font-size: 1.2rem; }
  }
</style>
